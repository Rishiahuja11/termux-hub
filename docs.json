{
  "fzf": {"syntax": "fzf [options]", "about": "Command-line fuzzy finder. Pipe any list and pick from it interactively.", "examples": ["find . -type f | fzf", "fzf --preview 'cat {}'", "history | fzf", "fzf --height 40% --reverse"], "options": ["--preview CMD : preview each line with CMD", "--height N : control height", "--multi : allow multi-select", "--bind KEY:ACTION : custom keybinds", "--tmux : run in tmux popup"]},
  "bat": {"syntax": "bat [OPTIONS] [FILE]...", "about": "cat clone with syntax highlighting, git integration and paging.", "examples": ["bat package.json", "bat -n file.py : show with line numbers", "bat --language=json app.js", "bat README.md | less"], "options": ["-n / --number : show line numbers", "-l LANG : force language", "--theme T : color theme", "-p : plain, no decorations"]},
  "ripgrep": {"syntax": "rg [OPTIONS] PATTERN [PATH]...", "about": "Ultra-fast recursive grep. Finds text in files.", "examples": ["rg \"TODO\" .", "rg -i hello src/", "rg --type py def main", "rg -l error . : list only filenames"], "options": ["-i : ignore case", "-l : only print filenames", "-g PATTERN : glob filter", "-r REPL : replace matches", "--type LANG : filter by language"]},
  "fd": {"syntax": "fd [OPTIONS] [PATTERN] [PATH]...", "about": "Simple, fast find alternative with nice colors and sensible defaults.", "examples": ["fd .jpg", "fd -e py", "fd -d 2 node_modules : depth limit", "fd pattern -x echo {}"], "options": ["-e EXT : by extension", "-d / --max-depth N : depth", "-t f / -t d : file or dir type", "-x CMD : execute command per result"]},
  "delta": {"syntax": "git diff | delta", "about": "Syntax-highlighting pager for git and diff output.", "examples": ["git diff | delta", "git log --pager=delta", "delta --side-by-side", "git diff --color=always | delta"], "options": ["--side-by-side : two-column diff", "--line-numbers : show line numbers", "--theme T : color theme", "--diff-highlight : word highlighting"]},
  "eza": {"syntax": "eza [OPTIONS] [PATH]...", "about": "Modern replacement for 'ls' with icons, git status, tree view.", "examples": ["eza -la", "eza --tree", "eza -la --git", "eza --icons=always --color=always"], "options": ["-l : long format", "--tree : tree view", "--git : git status column", "--sort name|size|date"]},
  "zoxide": {"syntax": "z [PATTERN]", "about": "Smart directory jumper that learns your most-used folders.", "examples": ["z projects", "zi : interactive picker", "z ~/server", "z -l : list recent"], "options": ["zi : interactive selection", "-l : list matching", "-r : strictly prove existence", "cd \"$(zoxide query pattern)\""]},
  "glow": {"syntax": "glow [FILE|DIR|URL]", "about": "Render markdown files beautifully in the terminal.", "examples": ["glow README.md", "glow . : browse markdown in dir", "glow venues.md --style dark", "glow | less"], "options": ["-s / --style STYLE : light|dark|auto", "-p : plain output", "-w WIDTH : wrap width", "--local : only local files"]},
  "hexyl": {"syntax": "hexyl [OPTIONS] FILE", "about": "Colorful hex viewer for binary files.", "examples": ["hexyl file.bin", "hexyl -n 64 file.bin : first 64 bytes", "hexyl --color auto file", "cat file | hexyl"], "options": ["-n / --length N : bytes to read", "-c COLOR : colorize differently", "-s / --skip N : skip bytes", "--block-size N"]},
  "dust": {"syntax": "dust [PATH]...", "about": "Disk usage visualizer that shows the biggest directories first.", "examples": ["dust", "dust ~/server", "dust -d 2", "dust -s : sorted by size"], "options": ["-d / --depth N", "-s : show only sizes", "-b : bytes instead of human", "--reverse : smallest first"]},
  "duf": {"syntax": "duf [OPTIONS]", "about": "Better 'df' - disk free with pretty colors and device grouping.", "examples": ["duf", "duf -only local", "duf -hide network", "duf --sort size"], "options": ["-only TYPE : local|network|fuse", "-hide TYPE : hide device types", "--sort field", "--json : JSON output"]},
  "btop": {"syntax": "btop", "about": "Resource monitor showing CPU, memory, disks, network and processes (TUI).", "examples": ["btop", "btop --utf-force", "btop -l cpu"], "options": ["-l / --lowest : lowest values mode", "-p : custom presets", "--utf-force : force UTF-8", "--tty LINESxCOLS"]},
  "bottom": {"syntax": "btm", "about": "Cross-platform terminal system monitor (alternative to btop).", "examples": ["btm", "btm -b : battery", "btm -c : CPU only"], "options": ["-b : battery widget", "-c : CPU only", "-m : memory only", "-d : disk only"]},
  "procs": {"syntax": "procs [QUERY]", "about": "Modern process list with colors, tree view and sorting.", "examples": ["procs", "procs python", "procs --tree", "procs -s cpu"], "options": ["-s / --sort FIELD : cpu|mem|pid", "--tree : tree view", "-w WIDTH", "--watch : refresh periodically"]},
  "tmux": {"syntax": "tmux [COMMAND]", "about": "Terminal multiplexer: run multiple sessions in one terminal.", "examples": ["tmux new -s work", "tmux ls", "tmux attach -t work", "Ctrl-b c (new window), Ctrl-b d (detach)"], "options": ["new -s NAME : new session", "ls : list sessions", "attach -t NAME : attach", "kill-session -t NAME"]},
  "jq": {"syntax": "jq [FILTER]", "about": "Command-line JSON processor - query and transform JSON data.", "examples": ["cat file.json | jq .key", "echo '[1,2,3]' | jq length", "curl -s api | jq '.items[0].name'", "jq '.[] | select(.size>100)' data.json"], "options": [".key : access key", ".[] : iterate array", "select(cond) : filter", "length : size of value", "| : pipe filters"]},
  "yq": {"syntax": "yq '[FILTER]' [FILE]", "about": "YAML/JSON processor, like jq but for YAML.", "examples": ["yq '.services.web.port' docker-compose.yml", "yq e '.a.b = 5' -i file.yml", "cat data.yml | yq .", "yq '.key | length' file.yml"], "options": ["-i : in-place edit", "-e : evaluate expression", "--tojson : convert to JSON", "-r : raw string output"]},
  "httpie": {"syntax": "http [METHOD] URL [items]", "about": "User-friendly HTTP client with colored pretty output.", "examples": ["http get example.com", "http POST api.site /items name=val", "http -h api.com/jobs", "http PUT /x id:=5"], "options": ["METHOD URL : verb+target", "key=val : form field", "key:=val : JSON value", "key: header:value", "-v : verbose", "-h : headers only"]},
  "aria2": {"syntax": "aria2c [OPTIONS] URL", "about": "Multi-connection download utility (fast downloads).", "examples": ["aria2c 'http://.../file.zip'", "aria2c -x 16 -s 16 URL : 16 connections", "aria2c -i urls.txt : batch", "aria2c -d downloaddir URL"], "options": ["-x N : max connections", "-d DIR : save dir", "-o NAME : output file", "-i FILE : list of URLs", "--continue=true : resume"]},
  "rsync": {"syntax": "rsync [OPTIONS] SRC DEST", "about": "Fast file sync/copy tool, incremental transfers.", "examples": ["rsync -avz src/ dest/", "rsync -av user@host:/dir/ ./", "rsync --delete src/ dest/", "rsync -az --progress big/ /backup/"], "options": ["-a : archive mode", "-v : verbose", "-z : compress", "--delete : remove extra","-n : dry-run", "-P : progress"]},
  "socat": {"syntax": "socat [ADDRESS] [ADDRESS]", "about": "SOcket CAT - multipurpose relay between two data channels.", "examples": ["socat TCP-LISTEN:8080,fork TCP:192.168.1.5:80", "socat - TCP:host:80 : to stdin/stdout", "socat TCP-L:22 UNIX:/var/run/sshd.sock"], "options": ["TCP-LISTEN:port : listen", "TCP:host:port : connect", "UDP-LISTEN:port", "EXEC:prog", ",fork : handle multiple clients"]},
  "ncat": {"syntax": "ncat [OPTIONS] [HOST] [PORT]", "about": "Netcat - read/write data across network connections.", "examples": ["ncat -l 8080 : listen", "ncat -l 8080 -c 'echo hi'", "ncat host 80", "ncat -zv host 1-100 : port scan"], "options": ["-l : listen", "-p PORT : source port", "-c CMD : execute", "-z : zero-I/O scan", "-v : verbose"]},
  "ncdu": {"syntax": "ncdu [PATH]", "about": "Interactive disk usage analyzer with navigable view.", "examples": ["ncdu", "ncdu ~/server", "ncdu -x : don't cross filesystems"], "options": ["-x : stay on filesystem", "-q : quiet (faster)", "-r : read-only mode", "keys: arrows navigate, d delete, g graph"]},
  "btop": {"syntax": "btop", "about": "Resource monitor showing CPU, memory, disks, network and processes (TUI).", "examples": ["btop", "btop --utf-force", "btop -l cpu"], "options": ["-l / --lowest : lowest values mode", "-p : custom presets", "--utf-force : force UTF-8", "--tty LINESxCOLS"]},
  "htop": {"syntax": "htop", "about": "Interactive process viewer with sorting and tree mode.", "examples": ["htop", "htop -u user : only user's procs", "htop --tree"], "options": ["-u USER : filter by user", "--tree : tree view", "-s FIELD : sort field", "keys: F1 help, F5 tree"]},
  "micro": {"syntax": "micro [FILE]...", "about": "Modern terminal text editor with mouse support and plugins.", "examples": ["micro file.py", "micro -r : readonly", "micro +10 file : open at line 10"], "options": ["-r : readonly", "+N : open at line N", "-c : colorscheme", "Ctrl-s save, Ctrl-q quit, Ctrl-e cmd"]},
  "vim": {"syntax": "vim [FILE]...", "about": "Highly configurable modal text editor.", "examples": ["vim file.txt", "vim -R file : readonly", "vim +'set nu' file"], "options": ["-R : readonly", ":wq : save+quit", ":q! : quit without save", "i insert, Esc normal, gg top"]},
  "neovim": {"syntax": "nvim [FILE]...", "about": "Modern fork of Vim with Lua config, LSP and built-in terminal.", "examples": ["nvim file.py", "nvim -p f1 f2 : tabs", "nvim +'lua print(1)'"], "options": ["-p : open in tabs", "-R : readonly", ":LspStart : start language server", ":terminal : embedded shell"]},
  "curl": {"syntax": "curl [OPTIONS] URL", "about": "Transfer data to/from servers over HTTP, FTP and more.", "examples": ["curl https://example.com", "curl -O http://file.zip : save", "curl -X POST -d 'a=1' http://api", "curl -H 'Authorization: Bearer x' url"], "options": ["-O : save remote name", "-o FILE : output file", "-X METHOD : http verb", "-H : header", "-d : data body", "-L : follow redirects"]},
  "watch": {"syntax": "watch [OPTIONS] COMMAND", "about": "Run a command repeatedly and show its output every interval.", "examples": ["watch -n 2 ls", "watch free -h", "watch -d 'netstat -tln'"], "options": ["-n SEC : interval", "-d : highlight changes", "-t : no title", "-x : run with shell"]},
  "atuin": {"syntax": "atuin [COMMAND]",
    "about": "Shell history sync and search with a beautiful interactive view (requires shell hook).",
    "examples": ["atuin search git", "atuin stats", "atuin init bash ; eval \"$(atuin init bash)\""],
    "options": ["search QUERY : fuzzy search history", "stats : most used commands", "history : list", "init SHELL : enable hook"]},
  "shellcheck": {"syntax": "shellcheck [OPTIONS] FILE", "about": "Static analysis tool for shell scripts - finds bugs and warnings.", "examples": ["shellcheck script.sh", "shellcheck -e SC2086 script.sh", "shellcheck -x source.sh"], "options": ["-e CODE : exclude check", "-x : follow source files", "-f format : json|gcc|tty", "-s shell : specify shell"]},
  "tree": {"syntax": "tree [PATH]", "about": "List files in a directory as a tree diagram.", "examples": ["tree", "tree -L 2", "tree -a : include hidden", "tree -d : dirs only"], "options": ["-L DEPTH : max depth", "-a : hidden files", "-d : directories only", "-h : human sizes"]},
  "tldr": {"syntax": "tldr COMMAND", "about": "Simplified man pages with practical examples for commands.", "examples": ["tldr tar", "tldr --random", "tldr curl"], "options": ["COMMAND : show examples", "--random : random command", "--list : all commands", "--search TERM : find"]},
  "cheat": {"syntax": "cheat [COMMAND]", "about": "Community cheat sheets for common commands.", "examples": ["cheat tar", "cheat -l : list sheets", "cheat -e tar : edit"], "options": ["COMMAND : show sheet", "-l : list", "-e : edit", "-s : search"]}
}
